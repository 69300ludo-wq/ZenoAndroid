<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/zeno_icon_cyan"
        android:label="Zeno"
        android:roundIcon="@drawable/zeno_icon_cyan"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zeno">

        <activity
            android:name=".LauncherActivityV124"
            android:exported="true"
            android:launchMode="singleTask" />
        <activity
            android:name=".LauncherActivityV123"
            android:exported="true"
            android:launchMode="singleTask" />
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask" />
        <activity android:name=".MainActivity" android:exported="true" />

        <activity
            android:name=".VoiceCommandActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <activity-alias
            android:name=".HomeLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/zeno_icon_cyan"
            android:label="Zeno Launcher"
            android:targetActivity=".LauncherActivityV124">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCyan"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/zeno_icon_cyan"
            android:label="Zeno"
            android:targetActivity=".LauncherActivityV124">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias android:name=".LauncherViolet" android:enabled="false" android:exported="true" android:icon="@drawable/zeno_icon_violet" android:label="Zeno" android:targetActivity=".LauncherActivityV124">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGold" android:enabled="false" android:exported="true" android:icon="@drawable/zeno_icon_gold" android:label="Zeno" android:targetActivity=".LauncherActivityV124">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGreen" android:enabled="false" android:exported="true" android:icon="@drawable/zeno_icon_green" android:label="Zeno" android:targetActivity=".LauncherActivityV124">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>

        <service
            android:name=".service.FloatingZenoService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating AI companion overlay activated by the user with optional voice wake phrase" />
        </service>
    </application>
</manifest>
